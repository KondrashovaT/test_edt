    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	СправочникБанковскиеСчетаКонтрагентов.Ссылка КАК Ссылка,
	СправочникБанковскиеСчетаКонтрагентов.Владелец КАК Владелец,
	СправочникБанковскиеСчетаКонтрагентов.Наименование КАК Наименование,
	СправочникБанковскиеСчетаКонтрагентов.НомерСчета КАК НомерСчета,
	СправочникБанковскиеСчетаКонтрагентов.Банк КАК Банк,
	СправочникБанковскиеСчетаКонтрагентов.ТекстНазначения КАК ТекстНазначения,
	НЕ ОсновныеБанковскиеСчетаКонтрагентов.БанковскийСчетКонтрагента ЕСТЬ NULL КАК ОсновнойСчет
ИЗ
	Справочник.БанковскиеСчетаКонтрагентов КАК СправочникБанковскиеСчетаКонтрагентов
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОсновныеБанковскиеСчетаКонтрагентов КАК ОсновныеБанковскиеСчетаКонтрагентов
		ПО СправочникБанковскиеСчетаКонтрагентов.Владелец = ОсновныеБанковскиеСчетаКонтрагентов.Контрагент
			И СправочникБанковскиеСчетаКонтрагентов.Ссылка = ОсновныеБанковскиеСчетаКонтрагентов.БанковскийСчетКонтрагента</queryText>
      <mainTable>Catalog.БанковскиеСчетаКонтрагентов</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
