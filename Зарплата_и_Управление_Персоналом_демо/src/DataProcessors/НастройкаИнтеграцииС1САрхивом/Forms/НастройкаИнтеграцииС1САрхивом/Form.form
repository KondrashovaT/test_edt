    </contextMenu>
    <type>InputField</type>
    <warningOnEditRepresentation>Show</warningOnEditRepresentation>
    <warningOnEdit>
      <key>ru</key>
      <value>Контроль версий осуществляется автоматически</value>
    </warningOnEdit>
    <editMode>Enter</editMode>
